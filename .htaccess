# apex-corner.com on cPanel/Apache.
#
# Netlify did four things for us silently. Apache does none of them by default,
# so they are written down here. Without this file the site still "works" when
# you click around the homepage, which is exactly why it would ship broken:
# the damage is on links that already exist out in the world.

# 1. PRETTY URLS. /privacy, /terms, /subscribe and /waitlist all return 200
#    today because Netlify adds the .html for us. Links already posted on
#    Instagram use them, and Stripe's after-payment redirect may too. Without
#    this they become 404s the moment the A record moves.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 2. FORCE HTTPS. The App Store listing, the app's own Settings screen and
  #    Stripe all point at https:// URLs. A plain-http fallback would show a
  #    browser warning on the page Apple's reviewer opens.
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # 3. ONE ADDRESS. www and non-www must not be two sites.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # ── /get — THE ONE ADDRESS THE APP EVER SENDS PEOPLE TO ──────────────────
  # Every invite email, every "send to your team" share and every gym-code
  # message points here, NEVER straight at TestFlight or the App Store.
  #
  # ⛔ WHY. The app used to link at whichever store was right "now", decided at
  # BUILD time. 36 of 37 invites ever sent pointed at an App Store page that did
  # not exist yet, and 13 real people never had a way in. A link inside somebody
  # else's WhatsApp cannot be corrected later — but this one can, because the
  # decision lives HERE and changes with one line and no build.
  #
  # ⛔ ON RELEASE DAY: change the target below to the App Store page
  #     https://apps.apple.com/gb/app/id6785041415
  # and deploy. Every link ever sent, including the old ones, starts working.
  # Until then it must stay on TestFlight. CLICK IT before calling it done.
  RewriteRule ^get/?$ https://testflight.apple.com/join/jrR5KQ2A [R=302,L]

  # Pretty URLs: /privacy -> /privacy.html, only when the file really exists.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ /$1.html [L]
</IfModule>

# 4. FRESH HTML. netlify.toml sent no-cache on every page so a pricing change
#    was never served stale from somebody's browser. Same rule here — but only
#    for HTML. Images and the wordmark can cache for a year; they never change
#    without changing name.
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(png|jpg|jpeg|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>

# Nothing that is not a page should be readable. There is an index.html.bak
# sitting in the project folder; a backup of a live page served to the public
# is how an old price list outlives the change that replaced it.
<FilesMatch "\.(bak|toml|json|log|sql|env)$">
  Require all denied
</FilesMatch>

# A real 404, not the homepage. Netlify returns a proper 404 today and quietly
# serving index.html instead would be a silent behaviour change — the kind that
# tells Google every wrong address is a real page.
ErrorDocument 404 /404.html
